# Compose 项目名（小写字母/数字/-/_），避免中文目录名导致 project name 为空
COMPOSE_PROJECT_NAME=ldmurdergame

# 数据库（PostgreSQL）
DB_NAME=app
DB_USER=app
DB_PASSWORD=app_pwd
DB_ROOT_PASSWORD=root_pwd

# 后端 JWT 签名密钥，生产环境请改成足够长的随机字符串
JWT_SECRET=change_me_to_a_long_random_string

# 门店统一业务时区：场次开始时间按此时区输出为带偏移的绝对时刻（页面跨时区一致）
APP_TIMEZONE=Asia/Shanghai

# 宿主机端口映射（如遇端口冲突可修改）
FRONTEND_PORT=28502
BACKEND_PORT=29502
DB_PORT=5432
